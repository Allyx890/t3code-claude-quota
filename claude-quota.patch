+  const { account, config, nowMs } = input;
+  if (input.busy) return false;
+  // A known reset needs no fresh probe to confirm it: Claude caches usage for 5 minutes, so
+  // waiting for two full probes would start the next window 5–11 minutes late.
+  const resetAtMs = input.lastResetAtMs;
