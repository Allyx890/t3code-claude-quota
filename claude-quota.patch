+describe("applyKnownResets", () => {
+  it("treats an account as full once its reported window has ended, until a newer probe", () => {
+    const resets = new Map([["a", nowMs - 40_000]]);
+    const spent = account("a", 0, { checkedAtMs: nowMs - 4 * 60_000 });
+    expect(applyKnownResets([spent], resets, nowMs)[0]).toMatchObject({
+      sessionRemaining: 100,
+      sessionResetsAtMs: null,
+      checkedAtMs: nowMs - 40_000,
+    });
+    // Too close to the reported reset, or already probed after it.
+    expect(applyKnownResets([spent], new Map([["a", nowMs - 10_000]]), nowMs)[0]).toBe(spent);
+    const probedAfter = { ...spent, checkedAtMs: nowMs - 5_000 };
+    expect(applyKnownResets([probedAfter], resets, nowMs)[0]).toBe(probedAfter);
+  });
+
+  it("still lets a limit hit after the reset empty the account", () => {
+    const reset = applyKnownResets(
+      [account("a", 0, { checkedAtMs: nowMs - 4 * 60_000 })],
+      new Map([["a", nowMs - 40_000]]),
+      nowMs,
+    );
+    expect(applyLimitHits(reset, new Map([["a", nowMs - 1_000]]))[0]?.sessionRemaining).toBe(0);
+  });
+});
