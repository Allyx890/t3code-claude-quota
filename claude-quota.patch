+  const configPath = path.join(config.stateDir, "claude-quota.json");
+  const logPath = path.join(config.logsDir, "claude-quota.ndjson");
+  const activationRoot = path.join(config.stateDir, "claude-quota-activation");
+  let lastSweepMs = 0;
+  let lastHeartbeatMs = 0;
+  let lastConfigText: string | null = null;
+  // Set from the event stream, so a run the limit stops is handled within seconds.
+  let failureSweepAtMs: number | null = null;
+  const lastProbeMs = new Map<string, number>();
+  const fullSinceMs = new Map<string, number>();
+  const lastActivationMs = new Map<string, number>();
+  // Only a delivered "hi" can be confirmed; a failed one must not claim the user's own usage.
+  const awaitingConfirmation = new Set<string>();
+  const lastResetAtMs = new Map<string, number>();
+  const lastReported = new Map<string, string>();
+  const limitHitAtMs = new Map<string, number>();
+  const limitedRuns = new Map<
+    string,
+    { readonly account: string; readonly idleCompaction: boolean; readonly atMs: number }
+  >();
+  const continuesAtMs = new Map<string, Array<number>>();
+
+  // Logging must never stop the sweep, so every failure is swallowed here.
+  const log = Effect.fn("ClaudeQuotaAutopilot.log")(function* (
+    event: string,
+    fields: Record<string, unknown>,
+  ) {
+    const line = `${encodeJson({ at: DateTime.formatIso(yield* DateTime.now), event, ...fields })}\n`;
+    const size = yield* fs.stat(logPath).pipe(
+      Effect.map((info) => Number(info.size)),
+      Effect.orElseSucceed(() => 0),
+    );
+    if (size > LOG_ROTATE_BYTES) yield* fs.rename(logPath, `${logPath}.1`);
+    yield* fs.makeDirectory(config.logsDir, { recursive: true });
+    yield* fs.writeFileString(logPath, line, { flag: "a" });
+  }, Effect.ignore());
+
+  /** Logs a decision only when it differs from the last one with the same key. */
+  const report = (key: string, event: string, fields: Record<string, unknown>) => {
+    const signature = `${event}:${encodeJson(fields)}`;
+    if (lastReported.get(key) === signature) return Effect.void;
+    lastReported.set(key, signature);
+    return log(event, fields);
+  };
+
+  const readConfig = Effect.gen(function* () {
+    const text = yield* fs.readFileString(configPath).pipe(Effect.orElseSucceed(() => null));
+    if (text === null) return null;
+    const decoded = yield* decodeConfig(text).pipe(Effect.option);
+    if (text !== lastConfigText) {
+      lastConfigText = text;
+      yield* decoded._tag === "Some"
+        ? log("config", { ...decoded.value })
+        : log("config_invalid", { path: configPath });
+    }
+    return decoded._tag === "Some" ? decoded.value : null;
+  });
+
+  const sampleAccounts = Effect.fn("ClaudeQuotaAutopilot.sampleAccounts")(function* (
+    settings: AutopilotConfig,
+    nowMs: number,
+  ) {
+    let providers = yield* registry.getProviders;
+    const pool: ReadonlyArray<string> =
+      settings.accounts.length > 0
+        ? settings.accounts
+        : providers
+            .filter((provider) => provider.driver === CLAUDE_DRIVER)
+            .map((provider) => provider.instanceId);
+    for (const id of pool) {
+      const provider = providers.find((candidate) => candidate.instanceId === id);
+      if (!provider) continue;
+      const checkedAtMs = provider.usageLimits ? Date.parse(provider.usageLimits.checkedAt) : 0;
+      if (nowMs - checkedAtMs < PROBE_EVERY_MS) continue;
+      if (nowMs - (lastProbeMs.get(id) ?? 0) < PROBE_EVERY_MS) continue;
+      lastProbeMs.set(id, nowMs);
+      providers = yield* registry.refreshInstance(provider.instanceId);
+    }
+    return providers.filter((provider) => pool.includes(provider.instanceId));
+  });
+
+  const activate = Effect.fn("ClaudeQuotaAutopilot.activate")(function* (
+    provider: ServerProvider,
+    settings: AutopilotConfig,
+    nowMs: number,
+  ) {
+    const modelSelection = activationSelection(provider, settings);
+    if (!modelSelection) return;
+    const attempt = `${provider.instanceId}:${nowMs}`;
+    const project = yield* ensureActivationProject(fs, projects, {
+      root: activationRoot,
+      modelSelection,
+      attempt,
+    });
+    yield* launch.launch({
+      commandId: CommandId.make(`claude-quota:hi:${attempt}`),
+      threadId: ThreadId.make(`${ACTIVATION_THREAD_PREFIX}${provider.instanceId}-${nowMs}`),
+      projectId: project.id,
+      title: `Quota timer · ${provider.displayName ?? provider.instanceId}`,
+      generateTitle: false,
+      modelSelection,
+      runtimeMode: "approval-required",
+      interactionMode: "default",
+      workspaceStrategy: { type: "root" },
+      initialMessage: { text: ACTIVATION_TEXT, attachments: [] },
+      createdBy: "user",
+      creationSource: "server",
+    });
+  });
+
+  /** The next moment a reported window ends, when a sweep should look again. */
+  const nextResetSweepMs = (afterMs: number) => {
+    let next: number | null = null;
+    for (const resetMs of lastResetAtMs.values()) {
+      const dueMs = resetMs + RESET_MARGIN_MS;
+      if (dueMs > afterMs && (next === null || dueMs < next)) next = dueMs;
+    }
+    return next;
+  };
+
+  const sweep = Effect.fn("ClaudeQuotaAutopilot.sweep")(function* () {
+    const nowMs = DateTime.toEpochMillis(yield* DateTime.now);
+    const resetDueMs = nextResetSweepMs(lastSweepMs);
+    if (
+      nowMs - lastSweepMs < SWEEP_EVERY_MS &&
+      (failureSweepAtMs === null || nowMs < failureSweepAtMs) &&
+      (resetDueMs === null || nowMs < resetDueMs)
+    )
+      return;
+    lastSweepMs = nowMs;
+    failureSweepAtMs = null;
+    const settings = yield* readConfig;
+    if (lastHeartbeatMs === 0) yield* log("started", { config: configPath });
+    if (!settings?.enabled) {
+      if (nowMs - lastHeartbeatMs >= HEARTBEAT_MS) {
+        lastHeartbeatMs = nowMs;
+        yield* log("heartbeat", { enabled: false });
+      }
+      return;
+    }
+
+    const providers = yield* sampleAccounts(settings, nowMs);
+    const probed = providers.map(readAccountQuota);
+    for (const account of probed) {
+      if (account.sessionResetsAtMs !== null) {
+        lastResetAtMs.set(account.id, account.sessionResetsAtMs);
+      }
+      yield* report(`account:${account.id}`, "account", {
+        account: account.id,
+        ready: account.ready,
+        sessionRemaining: account.sessionRemaining,
+        sessionResetsAt: isoOrNull(account.sessionResetsAtMs),
+        weeklyRemaining: account.weeklyRemaining,
+        ...(account.modelWeekly?.length ? { modelWeekly: account.modelWeekly } : {}),
+      });
+    }
+    if (nowMs - lastHeartbeatMs >= HEARTBEAT_MS) {
+      lastHeartbeatMs = nowMs;
+      yield* log("heartbeat", {
+        enabled: true,
+        observeOnly: settings.observeOnly,
+        accounts: probed.map((account) => ({
+          account: account.id,
+          sessionRemaining: account.sessionRemaining,
+          checkedAt: isoOrNull(account.checkedAtMs),
+        })),
+      });
+    }
+
+    // Settled threads stay in: auto-settle marks idle ones, and their next message still needs quota.
+    const shells = (yield* projections.getShellSnapshot({ location: "active" })).threads;
+
+    // Limited runs say more than a probe up to 5 minutes old: which account is empty right now,
+    // and whether the stopped run was work or only T3's idle compaction.
+    const histories = new Map<string, ThreadHistory>();
+    for (const thread of shells) {
+      const failedAtMs = limitFailureAtMs(thread);
+      if (failedAtMs === null || nowMs - failedAtMs > CONTINUE_WITHIN_MS) continue;
+      const runId = thread.latestRunId!;
+      let run = limitedRuns.get(runId);
+      if (run === undefined) {
+        const records = yield* projections
+          .getThreadRecords(thread.id, ["runs"], { runIds: [runId] })
+          .pipe(Effect.option);
+        const record = Option.isSome(records)
+          ? records.value.runs.find((candidate) => candidate.id === runId)
+          : undefined;
+        if (record === undefined) continue;
+        run = {
+          account: record.providerInstanceId,
+          idleCompaction: record.userMessageId.startsWith("idle-compact:"),
+          atMs: failedAtMs,
+        };
+        limitedRuns.set(runId, run);
+      }
+      limitHitAtMs.set(run.account, Math.max(limitHitAtMs.get(run.account) ?? 0, failedAtMs));
+      const recent = (continuesAtMs.get(thread.id) ?? []).filter(
+        (atMs) => nowMs - atMs <= CONTINUE_WITHIN_MS,
+      );
+      histories.set(thread.id, {
+        limitedRunAccount: run.account,
+        limitedRunWasIdleCompaction: run.idleCompaction,
+        recentContinues: recent.length,
+      });
+    }
+    const accounts = applyLimitHits(applyKnownResets(probed, lastResetAtMs, nowMs), limitHitAtMs);
+    const sessionLeft = (id: string) =>
+      pct(accounts.find((account) => account.id === id)?.sessionRemaining ?? null);
+
+    for (const thread of shells) {
+      const plan = planThreadSwitch(thread, accounts, settings, nowMs, histories.get(thread.id));
+      if (!plan) continue;
+      const from = thread.modelSelection.instanceId;
+      const base = { threadId: thread.id, title: thread.title, from };
+      if (plan.kind === "gave_up") {
+        yield* report(`thread:${thread.id}`, "continue_gave_up", {
+          ...base,
+          continues: plan.continues,
+          message: `Stopped resuming "${thread.title}" after ${plan.continues} tries; it resumes when ${from} resets.`,
+        });
+        continue;
+      }
+      if (plan.kind === "no_target") {
+        yield* report(`thread:${thread.id}`, "no_target", {
+          ...base,
+          model: thread.modelSelection.model,
+          message: `"${thread.title}" needs another account, but none has quota left for ${thread.modelSelection.model}.`,
+        });
+        continue;
+      }
+      if (plan.kind === "held") {
+        yield* report(`thread:${thread.id}`, "held_background", {
+          ...base,
+          backgroundTasks: plan.backgroundTasks,
+          message: `Kept "${thread.title}" on ${from} (${sessionLeft(from)} left) so its ${plan.backgroundTasks} background task(s) keep running.`,
+        });
+        continue;
+      }
+      const fields = {
+        ...base,
+        to: plan.target.id,
+        toRemaining: plan.target.sessionRemaining,
+        message:
+          plan.kind === "continue"
+            ? `Resumed "${thread.title}" on ${plan.target.id} (${pct(plan.target.sessionRemaining)} left) after ${from} ran out.`
