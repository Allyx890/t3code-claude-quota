+ * away: Claude caches usage for 5 minutes and probes are paced past that.
+ */
+export function applyKnownResets(
+  accounts: ReadonlyArray<AccountQuota>,
+  resetAtMs: ReadonlyMap<string, number>,
+  nowMs: number,
+): ReadonlyArray<AccountQuota> {
+  return accounts.map((account) => {
