+describe("planThreadSwitch reset fallback", () => {
+  const waiting = (id: string, minutes: number, extra: Partial<AccountQuota> = {}) =>
+    account(id, 0, { sessionResetsAtMs: nowMs + minutes * 60_000, ...extra });
+  const failed = (extra: Partial<OrchestrationV2ThreadShell> = {}) =>
+    thread({
+      status: "failed",
+      lastErrorClass: "usage_limit",
+      latestRunCompletedAt: DateTime.makeUnsafe(nowMs - 60_000),
+      modelSelection: {
+        instanceId: ProviderInstanceId.make("Claude5"),
+        model: "claude-opus-5-5",
+        options: [{ id: "effort", value: "max" }],
+      },
+      ...extra,
+    });
+  const pool = [waiting("Claude5", 120), waiting("Claude4", 60), waiting("Claude3", 90)];
+
+  it("sends one stable Continue from all-zero Claude5 to the earliest reset Claude4", () => {
+    const plan = planThreadSwitch(failed(), pool, config, nowMs);
+    expect(plan).toMatchObject({
+      kind: "continue",
+      target: { id: "Claude4" },
+      waitForResetAtMs: nowMs + 60 * 60_000,
+      command: {
+        type: "message.dispatch",
+        commandId: "claude-quota:continue:thread-1:run-1",
+        manualContinuationOfRunId: "run-1",
+        modelSelection: {
+          instanceId: "Claude4",
+          model: "claude-opus-5-5",
+          options: [{ id: "effort", value: "max" }],
+        },
+      },
+    });
+    expect(planThreadSwitch(failed(), pool, config, nowMs)).toEqual(plan);
+  });
+
+  it("does not bounce back on successive sweeps after the target really fails", () => {
+    const onTarget = failed({
+      latestRunId: RunId.make("run-2"),
+      modelSelection: {
+        ...failed().modelSelection,
+        instanceId: ProviderInstanceId.make("Claude4"),
+      },
+    });
+    for (const offset of [0, 1_000, 60_000]) {
+      expect(
+        planThreadSwitch(onTarget, pool, config, nowMs + offset, {
+          limitedRunAccount: "Claude4",
+          recentContinues: 4,
+        }),
+      ).toEqual({ kind: "no_target" });
+    }
+  });
+
+  it("allows the reset handoff even after three normal continues", () => {
+    expect(
+      planThreadSwitch(failed(), pool, config, nowMs, {
+        limitedRunAccount: "Claude5",
+        recentContinues: MAX_CONTINUES_PER_WINDOW,
+      }),
+    ).toMatchObject({ kind: "continue", target: { id: "Claude4" } });
+  });
+
+  it("prefers immediately usable quota when it recovers", () => {
+    const plan = planThreadSwitch(failed(), [...pool, account("ready", 30)], config, nowMs);
+    expect(plan).toMatchObject({ kind: "continue", target: { id: "ready" } });
+    expect(plan).not.toHaveProperty("waitForResetAtMs");
+  });
+
+  it("prefers healthy weekly quota, then earliest reset, and only then low positive weeks", () => {
+    const low = waiting("low", 10, { weeklyRemaining: 1 });
+    expect(planThreadSwitch(failed(), [...pool, low], config, nowMs)).toMatchObject({
+      kind: "continue",
+      target: { id: "Claude4" },
+    });
+    expect(
+      planThreadSwitch(
+        failed(),
+        [waiting("Claude5", 120, { weeklyRemaining: 2 }), low],
+        config,
+        nowMs,
+      ),
+    ).toMatchObject({ kind: "continue", target: { id: "low" } });
+  });
+
+  it("keeps the source for reset estimates within thirty seconds of the earliest", () => {
+    const near = [waiting("Claude4", 60), waiting("Claude5", 60.5)];
+    expect(planThreadSwitch(failed(), near, config, nowMs)).toEqual({ kind: "no_target" });
+    expect(
+      planThreadSwitch(failed(), [waiting("Claude5", 59), ...near.slice(0, 1)], config, nowMs),
+    ).toEqual({ kind: "no_target" });
+  });
+
+  it.each([
+    { ready: false },
+    { checkedAtMs: nowMs - 16 * 60_000 },
+    { checkedAtMs: Number.NaN },
+    { sessionRemaining: null },
+    { sessionRemaining: Number.NaN },
+    { sessionResetsAtMs: null },
+    { sessionResetsAtMs: Number.NaN },
+    { sessionResetsAtMs: Number.POSITIVE_INFINITY },
+    { sessionResetsAtMs: nowMs },
+    { weeklyRemaining: null },
+    { weeklyRemaining: Number.NaN },
+    { weeklyRemaining: 0 },
+    { weeklyRemaining: -1 },
+    { modelWeekly: [{ model: "opus", remaining: 0 }] },
+    { models: ["claude-sonnet-5-5"] },
+  ] satisfies Array<Partial<AccountQuota>>)("excludes unsafe reset candidates %j", (extra) => {
+    expect(
+      planThreadSwitch(
+        failed(),
+        [waiting("Claude5", 120), waiting("bad", 10, extra)],
+        config,
+        nowMs,
+      ),
+    ).toEqual({ kind: "no_target" });
+  });
+
+  it("never sends fallback for idle, compaction, old, unfinished, approved or settled work", () => {
+    for (const candidate of [
+      failed({ status: "completed", lastErrorClass: null }),
+      failed({ lastErrorClass: "unknown" }),
+      failed({ latestRunCompletedAt: DateTime.makeUnsafe(nowMs - 6 * 60 * 60_000) }),
+      failed({ latestRunCompletedAt: null }),
+      failed({ activeRunId: RunId.make("active") }),
+      failed({ status: "waiting" }),
+      failed({ settledOverride: "settled" }),
+      failed({
+        pendingRuntimeRequest: {
+          id: RuntimeRequestId.make("approval"),
+          kind: "permission",
+          createdAt: DateTime.makeUnsafe(nowMs),
+        },
+      }),
+      failed({
+        creationSource: "provider",
+        lineage: {
+          parentThreadId: ThreadId.make("parent"),
+          relationshipToParent: "subagent",
+          rootThreadId: ThreadId.make("parent"),
+        },
+      }),
+    ]) {
+      expect(planThreadSwitch(candidate, pool, config, nowMs)?.kind).not.toBe("continue");
+    }
+    expect(
+      planThreadSwitch(failed(), pool, config, nowMs, { limitedRunWasIdleCompaction: true }),
+    ).toEqual({ kind: "no_target" });
+    expect(
+      planThreadSwitch(failed(), pool, config, nowMs, { limitedRunAccount: "Claude4" })?.kind,
+    ).not.toBe("continue");
+  });
+});
