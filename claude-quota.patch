+export function planThreadSwitch(
+  thread: OrchestrationV2ThreadShell,
+  accounts: ReadonlyArray<AccountQuota>,
+  config: AutopilotConfig,
+  nowMs: number,
+  history: ThreadHistory = {},
+): SwitchPlan | null {
+  const sourceId = thread.modelSelection.instanceId;
+  const source = accounts.find((account) => account.id === sourceId);
+  if (
+    !source ||
+    thread.archivedAt !== null ||
+    thread.settledOverride === "settled" ||
+    // The provider owns a native subagent's conversation; its parent is the one to move.
+    isProviderNativeSubagentThread(thread) ||
+    thread.pendingRuntimeRequest !== null ||
+    thread.activeRunId !== null ||
+    RUNNING.has(thread.status) ||
+    thread.id.startsWith(ACTIVATION_THREAD_PREFIX)
+  )
+    return null;
+  const limitedAtMs = limitFailureAtMs(thread);
+  const limited =
+    limitedAtMs !== null &&
+    nowMs - limitedAtMs <= CONTINUE_WITHIN_MS &&
+    (history.limitedRunAccount ?? sourceId) === sourceId;
+  const continuing = limited && history.limitedRunWasIdleCompaction !== true;
+  const low =
+    limited ||
+    (isFresh(source, nowMs) &&
+      (isWeekLow(source, config, thread.modelSelection.model) ||
+        (source.sessionRemaining !== null &&
+          source.sessionRemaining <= config.switchAtRemainingPercent)));
+  // Old idle conversations move too: a message sent to one later would land on the empty account.
+  if (!continuing && !low) return null;
+  if (!continuing && backgroundTasksOf(thread).length > 0)
+    return { kind: "held", backgroundTasks: backgroundTasksOf(thread).length };
+  const continues = history.recentContinues ?? 0;
+  let target = pickTargetAccount(accounts, sourceId, thread.modelSelection.model, config, nowMs);
+  let waitForResetAtMs: number | undefined;
+  if (!target && continuing && thread.latestRunCompletedAt != null) {
+    target = pickResetAccount(accounts, sourceId, thread.modelSelection.model, config, nowMs);
+    if (target?.id === sourceId) return { kind: "no_target" };
+    if (target) waitForResetAtMs = target.sessionResetsAtMs!;
+  }
+  if (continuing && continues >= MAX_CONTINUES_PER_WINDOW && waitForResetAtMs === undefined)
+    return { kind: "gave_up", continues };
+  // Nothing to move to: the run waits for T3's own reset auto-resume on its account.
+  if (!target) return { kind: "no_target" };
+  const modelSelection: ModelSelection = { ...thread.modelSelection, instanceId: target.id };
+  if (continuing && thread.latestRunId) {
+    const key = `claude-quota:continue:${thread.id}:${thread.latestRunId}`;
+    return {
+      kind: "continue",
+      target,
+      ...(waitForResetAtMs === undefined ? {} : { waitForResetAtMs }),
+      command: {
+        type: "message.dispatch",
+        commandId: CommandId.make(key),
+        messageId: MessageId.make(key),
+        threadId: thread.id,
+        manualContinuationOfRunId: thread.latestRunId,
+        modelSelection,
+        text: continueText(thread),
+        attachments: [],
+        dispatchMode: { type: "start_immediately" },
+        createdBy: "user",
+        creationSource: "server",
+      },
+    };
+  }
+  return {
+    kind: "switch",
+    target,
+    command: {
+      type: "thread.model-selection.set",
+      commandId: CommandId.make(
+        `claude-quota:switch:${thread.id}:${thread.latestRunId ?? "new"}:${target.id}`,
+      ),
+      threadId: thread.id,
+      modelSelection,
+    },
+  };
+}
+
+/**
+ * Each activation gets a fresh thread, deleted once its run is over: the window starts when the
+ * message is processed, so the thread has nothing left to give.
+ */
+export function finishedActivationThreads(
+  shells: ReadonlyArray<OrchestrationV2ThreadShell>,
+  nowMs: number,
+): ReadonlyArray<OrchestrationV2ThreadShell> {
+  return shells.filter(
+    (thread) =>
+      thread.id.startsWith(ACTIVATION_THREAD_PREFIX) &&
+      // Past the TTL even a stuck one goes; deleting a thread cancels its run.
+      (nowMs - DateTime.toEpochMillis(thread.createdAt) >= ACTIVATION_THREAD_TTL_MS ||
+        (thread.activeRunId === null &&
+          !RUNNING.has(thread.status) &&
+          thread.pendingRuntimeRequest === null &&
+          thread.latestRunCompletedAt != null)),
+  );
+}
+
+/**
+ * A run that just failed may be a usage limit, and a finished "hi" leaves a thread to delete:
+ * both are worth a look within seconds instead of at the next minute.
+ */
+export function wakesSweepEarly(event: OrchestrationV2DomainEvent): boolean {
+  return (
+    event.type === "run.updated" &&
+    (event.payload.status === "failed" ||
+      (event.payload.status === "completed" && event.threadId.startsWith(ACTIVATION_THREAD_PREFIX)))
+  );
+}
+
+/** Full means 100% left with no running window, seen on fresh probes spanning the configured time. */
+export function isActivationDue(input: {
+  readonly account: AccountQuota;
+  readonly fullSinceMs: number | undefined;
+  readonly lastAttemptMs: number | undefined;
+  /** End of the latest 5-hour window any probe reported, even if a later probe no longer shows it. */
+  readonly lastResetAtMs?: number | undefined;
+  /** A run is going on the account, or one started since that window ended. */
+  readonly busy: boolean;
+  readonly config: AutopilotConfig;
+  readonly nowMs: number;
+}): boolean {
+  const { account, config, nowMs } = input;
+  if (input.busy) return false;
+  // A known reset needs no fresh probe to confirm it: Claude caches usage for 5 minutes, so
+  // waiting for two full probes would start the next window 5–11 minutes late.
+  const resetAtMs = input.lastResetAtMs;
+  if (
+    resetAtMs !== undefined &&
+    nowMs >= resetAtMs + RESET_MARGIN_MS &&
+    account.ready &&
+    !isWeekLow(account, config) &&
+    (input.lastAttemptMs === undefined || input.lastAttemptMs < resetAtMs)
+  )
+    return true;
+  return (
+    isAccountFull(account, config, nowMs) &&
+    input.fullSinceMs !== undefined &&
+    account.checkedAtMs - input.fullSinceMs >= config.activateAfterFullMinutes * 60_000 &&
+    (input.lastAttemptMs === undefined || nowMs - input.lastAttemptMs >= ACTIVATION_RETRY_MS)
+  );
+}
+
+/**
+ * Only a window ending after the "hi" was sent is its window. Until the next probe the snapshot
+ * still shows the window that just ended, and taking that as confirmation would send another.
+ */
+export function isActivationConfirmed(account: AccountQuota, sentAtMs: number | undefined) {
+  return (
+    sentAtMs !== undefined &&
+    account.sessionResetsAtMs !== null &&
+    account.sessionResetsAtMs > sentAtMs
+  );
+}
+
+export function isAccountFull(
+  account: AccountQuota,
+  config: AutopilotConfig,
+  nowMs: number,
+): boolean {
+  return (
+    account.ready &&
+    isFresh(account, nowMs) &&
+    !isWeekLow(account, config) &&
+    account.sessionRemaining === 100 &&
+    (account.sessionResetsAtMs === null || account.sessionResetsAtMs <= nowMs)
+  );
+}
+
+/** The cheapest selection for the activation "hi" that this account actually offers. */
+export function activationSelection(
+  provider: ServerProvider,
+  config: AutopilotConfig,
+): ModelSelection | null {
+  const model =
+    provider.models.find((candidate) => candidate.slug === config.activationModel) ??
+    provider.models.find((candidate) => candidate.isDefault) ??
+    provider.models[0];
+  if (!model) return null;
+  const effort = model.capabilities?.optionDescriptors?.find(
+    (descriptor) => descriptor.id === "effort" && descriptor.type === "select",
+  );
+  const offersEffort =
+    effort?.type === "select" &&
+    effort.options.some((choice) => choice.id === config.activationEffort);
+  return {
+    instanceId: provider.instanceId,
+    model: model.slug,
+    ...(offersEffort ? { options: [{ id: "effort", value: config.activationEffort }] } : {}),
+  };
+}
+
+export const ensureActivationProject = Effect.fn("ClaudeQuotaAutopilot.ensureActivationProject")(
+  function* (
+    fs: FileSystem.FileSystem,
+    projects: Projects.ProjectService["Service"],
