+          ];
+          assert.equal(followUp.status, "queued");
+          followUpRunId = followUp.id;
+          const resetAt = DateTime.formatIso(DateTime.add(now, { hours: 2 }));
+          yield* events.write({
+            events: [
+              {
+                id: EventId.make(`quota-autopilot:stop:${scenario}`),
+                type: "run.updated",
+                threadId,
+                occurredAt: now,
+                payload: { ...source, status: "failed", completedAt: now },
+              },
+              {
+                id: EventId.make(`quota-autopilot:hold:${scenario}`),
+                type: "run.updated",
+                threadId,
+                occurredAt: now,
+                payload: { ...followUp, queueHeld: true },
+              },
+              {
+                id: EventId.make(`quota-autopilot:error:${scenario}`),
+                type: "turn-item.updated",
+                threadId,
+                occurredAt: now,
+                payload: {
+                  id: TurnItemId.make(`quota-autopilot:error:${scenario}`),
+                  type: "error",
+                  threadId,
+                  runId: source.id,
+                  nodeId: source.rootNodeId,
+                  providerThreadId: null,
+                  providerTurnId: null,
+                  nativeItemRef: null,
+                  parentItemId: null,
+                  ordinal: 2,
+                  status: "failed",
+                  title: "Usage limit reached",
+                  startedAt: now,
+                  completedAt: now,
+                  updatedAt: now,
+                  failure: {
+                    class: "usage_limit",
+                    message: "Plan limit reached.",
+                    code: "usageLimitExceeded",
+                    retryable: null,
+                    resetAt,
+                  },
+                },
+              },
+            ],
+          });
+          // The stock reset worker arms itself too; it must stay harmless after the move.
+          const limited = (yield* orchestrator.getShellSnapshot()).threads.find(
+            (thread) => thread.id === threadId,
+          )!;
+          yield* orchestrator.dispatch(limitRecoveryCommand(limited, true, nowMs)!);
+          const armed = (yield* orchestrator.getShellSnapshot()).threads.find(
+            (thread) => thread.id === threadId,
+          )!;
+          scheduledResume = limitRecoveryCommand(armed, true, Date.parse(resetAt));
+          assert.isNotNull(scheduledResume);
+        }
+
+        const shell = (yield* orchestrator.getShellSnapshot()).threads.find(
+          (thread) => thread.id === threadId,
+        )!;
+        const account = (id: ProviderInstanceId, sessionRemaining: number) => ({
+          id,
+          ready: true,
+          sessionRemaining,
+          sessionResetsAtMs: null,
+          weeklyRemaining: 50,
+          models: [modelSelection.model],
+          checkedAtMs: nowMs,
+        });
+        const config = decodeAutopilotConfig({
+          enabled: true,
+          accounts: [modelSelection.instanceId, alternateInstanceId],
+        });
+        const plan = ClaudeQuotaAutopilot.planThreadSwitch(
+          shell,
+          [
+            account(modelSelection.instanceId, scenario === "limited" ? 0 : 3),
+            account(alternateInstanceId, 80),
+          ],
+          config,
+          nowMs,
+        );
+        assert.equal(plan?.kind, scenario === "limited" ? "continue" : "switch");
+        if (plan?.kind !== "continue" && plan?.kind !== "switch")
+          return assert.fail("expected a move");
+        yield* threads.dispatch(plan.command);
+        // A repeated sweep reuses the command id and must not start more work.
+        yield* threads.dispatch(plan.command);
+
+        const after = yield* orchestrator.getThreadProjection(threadId);
+        assert.equal(after.thread.modelSelection.instanceId, alternateInstanceId);
+        if (scenario === "limited") {
+          const continued = after.runs.find((run) =>
+            run.userMessageId.startsWith("claude-quota:continue:"),
+          );
+          assert.equal(continued?.status, "starting");
+          assert.equal(continued?.providerInstanceId, alternateInstanceId);
+
+          const moveQueue = ClaudeQuotaAutopilot.moveQueuedMessages(threads, {
+            threadId,
+            from: modelSelection.instanceId,
+            modelSelection: { ...modelSelection, instanceId: alternateInstanceId },
+          });
+          assert.equal(yield* moveQueue, 1);
+          // A repeated sweep finds nothing left on the empty account.
+          assert.equal(yield* moveQueue, 0);
+          const requeued = yield* orchestrator.getThreadProjection(threadId);
+          assert.equal(requeued.runs.find((run) => run.id === followUpRunId)?.status, "cancelled");
+          const copy = requeued.runs.find((run) =>
+            run.userMessageId.startsWith("claude-quota:requeue:"),
+          );
+          assert.deepEqual(
+            [copy?.providerInstanceId, copy?.status, copy?.queueHeld === true],
+            [alternateInstanceId, "queued", false],
+          );
+          assert.equal(
+            requeued.messages.find((message) => message.id === copy?.userMessageId)?.text,
+            "Then run the tests.",
+          );
+
+          const runCount = requeued.runs.length;
+          yield* TestClock.adjust("2 hours");
+          yield* orchestrator.dispatch(scheduledResume!);
+          assert.lengthOf((yield* orchestrator.getThreadProjection(threadId)).runs, runCount);
+        } else {
+          assert.lengthOf(after.runs, 0);
+        }
+        const moved = (yield* orchestrator.getShellSnapshot()).threads.find(
+          (thread) => thread.id === threadId,
+        )!;
+        assert.isNull(
+          ClaudeQuotaAutopilot.planThreadSwitch(
+            moved,
+            [account(modelSelection.instanceId, 3), account(alternateInstanceId, 80)],
+            config,
+            nowMs,
+          ),
+        );
+      }),
+  );
+});
