diff --git a/apps/server/src/orchestration-v2/ClaudeQuotaAutopilot.ts b/apps/server/src/orchestration-v2/ClaudeQuotaAutopilot.ts
new file mode 100644
index 00000000..94713dd8
--- /dev/null
+++ b/apps/server/src/orchestration-v2/ClaudeQuotaAutopilot.ts
@@ -0,0 +1,1232 @@
+/**
+ * Claude quota autopilot for users with several Claude subscriptions.
+ *
+ * - A conversation whose account is nearly out of its 5-hour or weekly quota moves to the
+ *   pooled account with the most quota left for its model. A run the limit already stopped
+ *   is resumed there within seconds, exactly like the composer's Resume button with another
+ *   account selected.
+ * - An idle account whose 5-hour window has ended gets a one-word message on a fresh thread,
+ *   so its next window starts counting down while nobody needs it. The thread is deleted
+ *   once the reply is in.
+ *
+ * Opt-in through `<stateDir>/claude-quota.json`; without that file nothing runs. Decisions
+ * are logged to `<logsDir>/claude-quota.ndjson`. Only existing commands, the event stream
+ * and the provider registry's usage probe are used, so this file is the whole feature.
+ */
+import {
+  type ClaudeQuotaNotices,
+  CommandId,
+  isProviderNativeSubagentThread,
+  MessageId,
+  ProjectId,
+  ThreadId,
+  type ModelSelection,
+  type OrchestrationV2Command,
+  type OrchestrationV2DomainEvent,
+  type OrchestrationV2ThreadShell,
+  type ProviderInstanceId,
+  type ServerProvider,
+} from "@t3tools/contracts";
+import * as Cause from "effect/Cause";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import * as SubscriptionRef from "effect/SubscriptionRef";
+import * as ServerConfig from "../config.ts";
+import * as Projects from "../project/ProjectService.ts";
+import * as Registry from "../provider/ProviderRegistry.ts";
+import * as Scheduler from "../scheduling/Scheduler.ts";
+import { forkParked } from "../serverActivation.ts";
+import * as ProjectionStore from "./ProjectionStore.ts";
+import * as ThreadLaunch from "./ThreadLaunchService.ts";
+import * as ThreadManagement from "./ThreadManagementService.ts";
+
+export const AutopilotConfig = Schema.Struct({
+  enabled: Schema.Boolean.pipe(Schema.withDecodingDefault(Effect.succeed(false))),
+  /** Log decisions without switching or sending anything. */
+  observeOnly: Schema.Boolean.pipe(Schema.withDecodingDefault(Effect.succeed(false))),
+  /**
+   * Provider instance ids that belong to the pool, e.g. ["claudeAgent", "Claude3"].
+   * Empty means every Claude instance.
+   */
+  accounts: Schema.Array(Schema.String).pipe(Schema.withDecodingDefault(Effect.succeed([]))),
+  switchAtRemainingPercent: Schema.Number.pipe(Schema.withDecodingDefault(Effect.succeed(5))),
+  /** Send the "hi" that starts an idle account's 5-hour window. */
+  activate: Schema.Boolean.pipe(Schema.withDecodingDefault(Effect.succeed(true))),
+  activateAfterFullMinutes: Schema.Number.pipe(Schema.withDecodingDefault(Effect.succeed(10))),
+  /** Falls back to the account's default model when the account does not offer it. */
+  activationModel: Schema.String.pipe(
+    Schema.withDecodingDefault(Effect.succeed("claude-haiku-5-5")),
+  ),
+  /** Applied only when the chosen model offers this effort level. */
+  activationEffort: Schema.String.pipe(Schema.withDecodingDefault(Effect.succeed("low"))),
+});
+export type AutopilotConfig = typeof AutopilotConfig.Type;
+const decodeConfig = Schema.decodeUnknownEffect(Schema.fromJsonString(AutopilotConfig));
+const encodeJson = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown));
+const isoOrNull = (ms: number | null) =>
+  ms === null || !Number.isFinite(ms) ? null : DateTime.formatIso(DateTime.makeUnsafe(ms));
+
+// Failed runs and known resets wake a sweep early, so this only paces idle moves.
+const SWEEP_EVERY_MS = 60_000;
+// The run's final items can land just after the run update that wakes the sweep.
+const RUN_SETTLE_MS = 2_000;
+const PROBE_EVERY_MS = 300_000;
+const ACTIVE_PROBE_EVERY_MS = 60_000;
+const MAX_PROBE_RETRY_MS = 15 * 60_000;
+const FRESH_MS = 15 * 60_000;
+const ACTIVATION_RETRY_MS = 30 * 60_000;
+// Reported reset times agree to within a second; the margin keeps a "hi" out of the old window.
+const RESET_MARGIN_MS = 30_000;
+// One 5-hour window: older limited runs were abandoned or already resumed by the reset worker,
+// and continuing them unasked would restart forgotten work.
+const CONTINUE_WITHIN_MS = 5 * 60 * 60_000;
+const HEARTBEAT_MS = 30 * 60_000;
+const LOG_ROTATE_BYTES = 2 * 1024 * 1024;
+const CONTINUE_TEXT = "Continue where you left off.";
+const ACTIVATION_TEXT = "Only reply with 'Hi'.";
+// A launch that never produced a finished run is given up on after this long.
+const ACTIVATION_THREAD_TTL_MS = 30 * 60_000;
+const ACTIVATION_THREAD_PREFIX = "claude-quota-hi-";
+const CLAUDE_DRIVER = "claudeAgent";
+const describe = (cause: Cause.Cause<unknown>) => {
+  const error = Cause.squash(cause);
+  return error instanceof Error ? error.message : String(error);
+};
+const RUNNING = new Set(["preparing", "queued", "starting", "running", "waiting"]);
+
+export interface AccountQuota {
+  readonly id: ProviderInstanceId;
+  readonly ready: boolean;
+  /** 5-hour quota left, 0–100; null when the account has not reported it. */
+  readonly sessionRemaining: number | null;
+  readonly sessionResetsAtMs: number | null;
+  /** Least weekly quota left across the account-wide weekly windows, 0–100; null when none is reported. */
+  readonly weeklyRemaining: number | null;
+  /** Weekly windows that only count one model, keyed by a slug fragment such as "opus". */
+  readonly modelWeekly?: ReadonlyArray<{ readonly model: string; readonly remaining: number }>;
+  readonly models: ReadonlyArray<string>;
+  readonly checkedAtMs: number;
+}
+
+export function readAccountQuota(provider: ServerProvider): AccountQuota {
+  const limits = provider.usageLimits;
+  const windows = limits?.unavailable ? [] : (limits?.windows ?? []);
+  const session = windows.find((window) => window.id === "five_hour");
+  const resetsAtMs = session?.resetsAt ? Date.parse(session.resetsAt) : Number.NaN;
+  // Claude names a model's own weekly window `seven_day_<display name>`.
+  const scoped = (window: (typeof windows)[number]) =>
+    window.kind === "weekly" && window.id.startsWith("seven_day_");
+  const weekly = windows.filter((window) => window.kind === "weekly" && !scoped(window));
+  return {
+    id: provider.instanceId,
+    ready: provider.enabled && provider.status === "ready",
+    sessionRemaining: session ? 100 - session.usedPercent : null,
+    sessionResetsAtMs: Number.isFinite(resetsAtMs) ? resetsAtMs : null,
+    weeklyRemaining:
+      weekly.length === 0 ? null : Math.min(...weekly.map((window) => 100 - window.usedPercent)),
+    modelWeekly: windows.filter(scoped).map((window) => ({
+      model: window.id.slice("seven_day_".length).replace(/_+/g, "-").replace(/^-|-$/g, ""),
+      remaining: 100 - window.usedPercent,
+    })),
+    models: provider.models.map((model) => model.slug),
+    checkedAtMs: limits ? Date.parse(limits.checkedAt) : Number.NaN,
+  };
+}
+
+const isFresh = (account: AccountQuota, nowMs: number) => nowMs - account.checkedAtMs <= FRESH_MS;
+
+const probeRetryInterval = (active: boolean, failures: number) =>
+  Math.min(
+    MAX_PROBE_RETRY_MS,
+    (active ? ACTIVE_PROBE_EVERY_MS : PROBE_EVERY_MS) * 2 ** Math.min(4, Math.max(0, failures)),
+  );
+
+/** Sparse streamed updates can advance checkedAt while leaving another window unchanged. */
+export function isUsageProbeDue(
+  provider: ServerProvider,
+  nowMs: number,
+  lastProbeMs: number | undefined,
+  active: boolean,
+  consecutiveFailures = 0,
+): boolean {
+  if (provider.driver !== CLAUDE_DRIVER || !provider.enabled) return false;
+  const interval = probeRetryInterval(active, consecutiveFailures);
+  if (lastProbeMs !== undefined && nowMs - lastProbeMs < interval) return false;
+  const checkedAtMs = provider.usageLimits ? Date.parse(provider.usageLimits.checkedAt) : NaN;
+  return active || !Number.isFinite(checkedAtMs) || nowMs - checkedAtMs >= interval;
+}
+
+/** Weekly quota left for `model`: the account-wide windows plus any window of that model's own. */
+export function weeklyRemainingFor(account: AccountQuota, model?: string): number | null {
+  let remaining = account.weeklyRemaining;
+  for (const window of account.modelWeekly ?? []) {
+    if (model === undefined || !model.includes(window.model)) continue;
+    remaining = remaining === null ? window.remaining : Math.min(remaining, window.remaining);
+  }
+  return remaining;
+}
+const isWeekLow = (account: AccountQuota, config: AutopilotConfig, model?: string) => {
+  const remaining = weeklyRemainingFor(account, model);
+  return remaining !== null && remaining <= config.switchAtRemainingPercent;
+};
+
+/** The pooled account offering `model` with the most 5-hour quota left, both windows above the threshold. */
+export function pickTargetAccount(
+  accounts: ReadonlyArray<AccountQuota>,
+  sourceId: ProviderInstanceId,
+  model: string,
+  config: AutopilotConfig,
+  nowMs: number,
+): AccountQuota | null {
+  let best: AccountQuota | null = null;
+  for (const account of accounts) {
+    if (
+      account.id === sourceId ||
+      !account.ready ||
+      !isFresh(account, nowMs) ||
+      !account.models.includes(model) ||
+      isWeekLow(account, config, model) ||
+      account.sessionRemaining === null ||
+      !Number.isFinite(account.sessionRemaining) ||
+      account.sessionRemaining <= config.switchAtRemainingPercent
+    )
+      continue;
+    if (best === null || account.sessionRemaining > (best.sessionRemaining ?? 0)) best = account;
+  }
+  return best;
+}
+
+/** Include the source so repeated limit failures settle on the best account to await reset. */
+function pickResetAccount(
+  accounts: ReadonlyArray<AccountQuota>,
+  sourceId: ProviderInstanceId,
+  model: string,
+  config: AutopilotConfig,
+  nowMs: number,
+): AccountQuota | null {
+  const candidates = accounts.filter((account) => {
+    const weekly = weeklyRemainingFor(account, model);
+    return (
+      account.ready &&
+      Number.isFinite(account.checkedAtMs) &&
+      account.checkedAtMs <= nowMs &&
+      isFresh(account, nowMs) &&
+      account.models.includes(model) &&
+      account.sessionRemaining !== null &&
+      Number.isFinite(account.sessionRemaining) &&
+      account.sessionRemaining <= config.switchAtRemainingPercent &&
+      weekly !== null &&
+      Number.isFinite(weekly) &&
+      weekly > 0 &&
+      account.sessionResetsAtMs !== null &&
+      Number.isFinite(account.sessionResetsAtMs) &&
+      account.sessionResetsAtMs > nowMs
+    );
+  });
+  const healthy = candidates.filter(
+    (account) => weeklyRemainingFor(account, model)! > config.switchAtRemainingPercent,
+  );
+  const eligible = healthy.length > 0 ? healthy : candidates;
+  let best: AccountQuota | null = null;
+  for (const account of eligible) {
+    if (best === null || account.sessionResetsAtMs! < best.sessionResetsAtMs!) best = account;
+  }
+  if (best === null) return null;
+  // Compare against the actual earliest reset, rather than a non-transitive fuzzy sort.
+  const source = eligible.find((account) => account.id === sourceId);
+  return source && source.sessionResetsAtMs! - best.sessionResetsAtMs! <= RESET_MARGIN_MS
+    ? source
+    : best;
+}
+
+/**
+ * Moving a thread to another account closes its provider session, killing these. T3's own
+ * pull request watches are not part of the session and survive.
+ */
+const backgroundTasksOf = (thread: OrchestrationV2ThreadShell) =>
+  (thread.pendingBackgroundTasks ?? []).filter(
+    (task) => !task.taskId.startsWith("pull-request-watch:"),
+  );
+
+function continueText(thread: OrchestrationV2ThreadShell): string {
+  const tasks = backgroundTasksOf(thread);
+  if (tasks.length === 0) return CONTINUE_TEXT;
+  const list = tasks.map((task) => task.description ?? `${task.kind} ${task.taskId}`).join("; ");
+  return `${CONTINUE_TEXT} The previous account ran out of quota, and switching accounts stopped this thread's background tasks (${list}). Check their state and restart the ones that are still needed.`;
+}
+
+/** What the sweep knows about a thread beyond its shell. */
+export interface ThreadHistory {
+  /**
+   * The account the limited run used. A thread already moved off it keeps the failed status,
+   * which must not move it again.
+   */
+  readonly limitedRunAccount?: string;
+  /** The limited run was T3's idle `/compact`, so there is no work to continue. */
+  readonly limitedRunWasIdleCompaction?: boolean;
+  /** Automatic continues already sent within the last window. */
+  readonly recentContinues?: number;
+}
+
+/** Each continue that fails again costs a handoff; past this the reset auto-resume takes over. */
+export const MAX_CONTINUES_PER_WINDOW = 3;
+
+/** Usage limit runs whose failure tells more than the account's probe. */
+function limitFailureAtMs(thread: OrchestrationV2ThreadShell): number | null {
+  return thread.status === "failed" &&
+    thread.lastErrorClass === "usage_limit" &&
+    thread.latestRunId !== null
+    ? DateTime.toEpochMillis(thread.latestRunCompletedAt ?? thread.updatedAt)
+    : null;
+}
+
+/** An account a run just hit the limit on counts as empty until a later probe says otherwise. */
+export function applyLimitHits(
+  accounts: ReadonlyArray<AccountQuota>,
+  limitHitAtMs: ReadonlyMap<string, number>,
+): ReadonlyArray<AccountQuota> {
+  return accounts.map((account) =>
+    (limitHitAtMs.get(account.id) ?? Number.NEGATIVE_INFINITY) > account.checkedAtMs
+      ? { ...account, sessionRemaining: 0 }
+      : account,
+  );
+}
+
+/**
+ * A window whose reported end has passed is full again, though the next probe may be minutes
+ * away: Claude caches usage for 5 minutes and probes are paced past that.
+ */
+export function applyKnownResets(
+  accounts: ReadonlyArray<AccountQuota>,
+  resetAtMs: ReadonlyMap<string, number>,
+  nowMs: number,
+): ReadonlyArray<AccountQuota> {
+  return accounts.map((account) => {
+    const resetMs = resetAtMs.get(account.id);
+    return resetMs !== undefined &&
+      nowMs >= resetMs + RESET_MARGIN_MS &&
+      account.checkedAtMs < resetMs
+      ? { ...account, sessionRemaining: 100, sessionResetsAtMs: null, checkedAtMs: resetMs }
+      : account;
+  });
+}
+
+export type SwitchPlan =
+  | { readonly kind: "no_target" }
+  /** Low but idle with live background tasks: switching now would kill them, so wait for an actual limit. */
+  | { readonly kind: "held"; readonly backgroundTasks: number }
+  | { readonly kind: "gave_up"; readonly continues: number }
+  | {
+      readonly kind: "continue";
+      readonly target: AccountQuota;
+      readonly waitForResetAtMs?: number;
+      readonly command: OrchestrationV2Command;
+    }
+  | {
+      readonly kind: "switch";
+      readonly target: AccountQuota;
+      readonly command: OrchestrationV2Command;
+    };
