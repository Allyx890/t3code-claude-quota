+          }),
+        ),
+        Effect.catchCause((cause) =>
+          log("activation_failed", {
+            account: account.id,
+            cause: describe(cause),
+            message: `Could not start ${account.id}'s 5-hour window.`,
+          }),
+        ),
+      );
+    }
+
+    // State per run and thread would otherwise grow for as long as the server runs.
+    const liveThreads = new Set<string>(shells.map((thread) => thread.id));
+    for (const [runId, run] of limitedRuns) {
+      if (nowMs - run.atMs > CONTINUE_WITHIN_MS) limitedRuns.delete(runId);
+    }
+    for (const [threadId, times] of continuesAtMs) {
+      if (!liveThreads.has(threadId) || times.every((atMs) => nowMs - atMs > CONTINUE_WITHIN_MS))
+        continuesAtMs.delete(threadId);
+    }
+    for (const key of lastReported.keys()) {
+      const separator = key.indexOf(":");
+      const scope = key.slice(0, separator);
+      if (
+        (scope === "thread" || scope === "activation-delete") &&
+        !liveThreads.has(key.slice(separator + 1))
+      )
+        lastReported.delete(key);
+    }
+  });
