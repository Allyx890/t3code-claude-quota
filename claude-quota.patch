+/** Full means 100% left with no running window, seen on fresh probes spanning the configured time. */
+export function isActivationDue(input: {
+  readonly account: AccountQuota;
+  readonly fullSinceMs: number | undefined;
+  readonly lastAttemptMs: number | undefined;
+  /** End of the latest 5-hour window any probe reported, even if a later probe no longer shows it. */
+  readonly lastResetAtMs?: number | undefined;
