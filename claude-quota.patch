+
+export function isAccountFull(
+  account: AccountQuota,
+  config: AutopilotConfig,
+  nowMs: number,
+): boolean {
+  return (
+    account.ready &&
+    isFresh(account, nowMs) &&
+    !isWeekLow(account, config) &&
+    account.sessionRemaining === 100 &&
+    (account.sessionResetsAtMs === null || account.sessionResetsAtMs <= nowMs)
