+describe("activation", () => {
+  it("deletes an activation thread once its run is over, and only then", () => {
+    const hi = (extra: Partial<OrchestrationV2ThreadShell>) =>
+      thread({
+        id: ThreadId.make(`claude-quota-hi-a-${Object.keys(extra).join("-")}`),
+        createdAt: DateTime.makeUnsafe(nowMs - 60_000),
+        latestRunCompletedAt: null,
+        ...extra,
+      });
+    const done = hi({ latestRunCompletedAt: DateTime.makeUnsafe(nowMs - 5_000) });
+    const abandoned = hi({ createdAt: DateTime.makeUnsafe(nowMs - 31 * 60_000) });
+    // Waiting on an approval nobody will give: deleting it cancels the run.
+    const stuck = hi({
+      status: "waiting",
+      activeRunId: RunId.make("run-3"),
+      createdAt: DateTime.makeUnsafe(nowMs - 45 * 60_000),
+    });
+    expect(
+      finishedActivationThreads(
+        [
+          done,
+          abandoned,
+          hi({ status: "running", activeRunId: RunId.make("run-2") }),
+          stuck,
+          hi({ status: "starting" }),
+          // A fresh launch whose run has not been recorded yet.
+          hi({ latestRunId: null }),
+          thread({ latestRunCompletedAt: DateTime.makeUnsafe(nowMs - 5_000) }),
+        ],
+        nowMs,
+      ),
+    ).toEqual([done, abandoned, stuck]);
+  });
+
+  const full = account("b", 100);
+  const due = (overrides: Partial<Parameters<typeof isActivationDue>[0]> = {}) =>
+    isActivationDue({
+      account: full,
+      fullSinceMs: nowMs - 10 * 60_000,
+      lastAttemptMs: undefined,
+      busy: false,
+      config,
+      nowMs,
+      ...overrides,
+    });
+
+  it("is due once fresh probes have shown a full idle account for the configured time", () => {
+    expect(due()).toBe(true);
+    expect(due({ fullSinceMs: nowMs - 9 * 60_000 })).toBe(false);
+    expect(due({ fullSinceMs: undefined })).toBe(false);
+    expect(due({ busy: true })).toBe(false);
+    expect(due({ lastAttemptMs: nowMs - 10 * 60_000 })).toBe(false);
+    expect(due({ lastAttemptMs: nowMs - 31 * 60_000 })).toBe(true);
+  });
+
+  it("is due right after a known window ends, before any probe shows the account full", () => {
+    const resetAtMs = nowMs - 40_000;
+    // The last probe ran before the reset: 0% left in a window that has since ended.
+    const spent = account("b", 0, {
+      sessionResetsAtMs: resetAtMs,
+      checkedAtMs: nowMs - 4 * 60_000,
+    });
+    const afterReset = (overrides: Partial<Parameters<typeof isActivationDue>[0]> = {}) =>
+      due({ account: spent, fullSinceMs: undefined, lastResetAtMs: resetAtMs, ...overrides });
+    expect(afterReset()).toBe(true);
+    expect(afterReset({ lastAttemptMs: nowMs - 6 * 60 * 60_000 })).toBe(true);
+    // Too close to the reported reset, already sent for this window, in use, or out of weekly quota.
+    expect(afterReset({ lastResetAtMs: nowMs - 20_000 })).toBe(false);
+    expect(afterReset({ lastAttemptMs: nowMs - 10_000 })).toBe(false);
+    expect(afterReset({ busy: true })).toBe(false);
+    expect(afterReset({ account: { ...spent, weeklyRemaining: 3 } })).toBe(false);
+    expect(afterReset({ account: { ...spent, ready: false } })).toBe(false);
+    expect(afterReset({ lastResetAtMs: undefined })).toBe(false);
+  });
+
+  it("confirms an activation only from a window that started after it", () => {
+    const sentAtMs = nowMs - 20_000;
+    const ended = account("b", 0, { sessionResetsAtMs: nowMs - 60_000 });
+    const started = account("b", 99, { sessionResetsAtMs: sentAtMs + 5 * 60 * 60_000 });
+    expect(isActivationConfirmed(ended, sentAtMs)).toBe(false);
+    expect(isActivationConfirmed(account("b", 100), sentAtMs)).toBe(false);
+    expect(isActivationConfirmed(started, undefined)).toBe(false);
+    expect(isActivationConfirmed(started, sentAtMs)).toBe(true);
+  });
+
+  it("does not count an account whose window is already running or whose week is nearly spent", () => {
+    const full = (extra: Partial<AccountQuota>, remaining = 100) =>
+      isAccountFull(account("b", remaining, extra), config, nowMs);
+    expect(full({ sessionResetsAtMs: nowMs + 60_000 })).toBe(false);
+    expect(full({ weeklyRemaining: 5 })).toBe(false);
+    expect(full({}, 99)).toBe(false);
+    expect(full({ checkedAtMs: nowMs - 60 * 60_000 })).toBe(false);
+    expect(full({ sessionResetsAtMs: nowMs - 1 })).toBe(true);
+  });
+});
