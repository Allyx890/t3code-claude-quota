+            thread.activeRunId !== null ||
+            RUNNING.has(thread.status) ||
+            (failedAtMs !== null && nowMs - failedAtMs < PROBE_EVERY_MS)
+          );
+        })
+        .map((thread) => thread.modelSelection.instanceId),
+    );
+    const providers = yield* sampleAccounts(settings, nowMs, activeAccounts);
+    // Probes timestamp their results after this sweep starts.
+    nowMs = DateTime.toEpochMillis(yield* DateTime.now);
+    const probed = providers.map(readAccountQuota);
+    for (const account of probed) {
+      if (account.sessionResetsAtMs !== null) {
+        lastResetAtMs.set(account.id, account.sessionResetsAtMs);
+      }
+      yield* report(`account:${account.id}`, "account", {
+        account: account.id,
+        ready: account.ready,
+        sessionRemaining: account.sessionRemaining,
+        sessionResetsAt: isoOrNull(account.sessionResetsAtMs),
+        weeklyRemaining: account.weeklyRemaining,
+        checkedAt: isoOrNull(account.checkedAtMs),
+        ...(account.modelWeekly?.length ? { modelWeekly: account.modelWeekly } : {}),
+      });
+    }
+    if (nowMs - lastHeartbeatMs >= HEARTBEAT_MS) {
+      lastHeartbeatMs = nowMs;
+      yield* log("heartbeat", {
+        enabled: true,
+        observeOnly: settings.observeOnly,
+        accounts: probed.map((account) => ({
+          account: account.id,
+          sessionRemaining: account.sessionRemaining,
+          checkedAt: isoOrNull(account.checkedAtMs),
+        })),
+      });
+    }
+
+    // Limited runs say more than a probe up to 5 minutes old: which account is empty right now,
+    // and whether the stopped run was work or only T3's idle compaction.
+    const histories = new Map<string, ThreadHistory>();
+    for (const thread of shells) {
+      const failedAtMs = limitFailureAtMs(thread);
+      if (failedAtMs === null || nowMs - failedAtMs > CONTINUE_WITHIN_MS) continue;
+      const runId = thread.latestRunId!;
+      let run = limitedRuns.get(runId);
+      if (run === undefined) {
+        const records = yield* projections
+          .getThreadRecords(thread.id, ["runs"], { runIds: [runId] })
+          .pipe(Effect.option);
+        const record = Option.isSome(records)
+          ? records.value.runs.find((candidate) => candidate.id === runId)
+          : undefined;
+        if (record === undefined) continue;
+        run = {
+          account: record.providerInstanceId,
+          idleCompaction: record.userMessageId.startsWith("idle-compact:"),
+          atMs: failedAtMs,
+        };
+        limitedRuns.set(runId, run);
+      }
+      limitHitAtMs.set(run.account, Math.max(limitHitAtMs.get(run.account) ?? 0, failedAtMs));
+      const recent = (continuesAtMs.get(thread.id) ?? []).filter(
+        (atMs) => nowMs - atMs <= CONTINUE_WITHIN_MS,
+      );
+      histories.set(thread.id, {
+        limitedRunAccount: run.account,
+        limitedRunWasIdleCompaction: run.idleCompaction,
+        recentContinues: recent.length,
+      });
+    }
+    const accounts = applyLimitHits(applyKnownResets(probed, lastResetAtMs, nowMs), limitHitAtMs);
+    const sessionLeft = (id: string) =>
+      pct(accounts.find((account) => account.id === id)?.sessionRemaining ?? null);
+
+    for (const thread of shells) {
+      const plan = planThreadSwitch(thread, accounts, settings, nowMs, histories.get(thread.id));
+      if (!plan) continue;
+      const from = thread.modelSelection.instanceId;
+      const base = { threadId: thread.id, title: thread.title, from };
+      if (plan.kind === "gave_up") {
+        yield* report(`thread:${thread.id}`, "continue_gave_up", {
+          ...base,
+          continues: plan.continues,
+          message: `Stopped resuming "${thread.title}" after ${plan.continues} tries; it resumes when ${from} resets.`,
+        });
+        continue;
+      }
+      if (plan.kind === "no_target") {
+        yield* report(`thread:${thread.id}`, "no_target", {
+          ...base,
+          model: thread.modelSelection.model,
+          accounts: accounts.map((account) => ({
+            account: account.id,
+            ready: account.ready,
+            sessionRemaining: account.sessionRemaining,
+            weeklyRemaining: weeklyRemainingFor(account, thread.modelSelection.model),
+            sessionResetsAt: isoOrNull(account.sessionResetsAtMs),
+            supportsModel: account.models.includes(thread.modelSelection.model),
+            fresh: isFresh(account, nowMs),
+          })),
+          message: `"${thread.title}" needs another account, but none has quota left for ${thread.modelSelection.model}.`,
+        });
+        continue;
+      }
+      if (plan.kind === "held") {
+        yield* report(`thread:${thread.id}`, "held_background", {
+          ...base,
+          backgroundTasks: plan.backgroundTasks,
+          message: `Kept "${thread.title}" on ${from} (${sessionLeft(from)} left) so its ${plan.backgroundTasks} background task(s) keep running.`,
+        });
+        continue;
+      }
+      const waitForResetAtMs = plan.kind === "continue" ? plan.waitForResetAtMs : undefined;
+      const action =
+        waitForResetAtMs !== undefined
+          ? "waiting_for_reset"
+          : plan.kind === "continue"
+            ? "continued"
+            : "switched";
+      const fields = {
+        ...base,
+        to: plan.target.id,
+        toRemaining: plan.target.sessionRemaining,
+        ...(waitForResetAtMs !== undefined ? { resetsAt: isoOrNull(waitForResetAtMs) } : {}),
+        message:
+          waitForResetAtMs !== undefined
+            ? `Sent a continuation of "${thread.title}" to ${plan.target.id}, whose 5-hour quota resets at ${isoOrNull(waitForResetAtMs)}; T3's limit recovery takes over when the account confirms its limit.`
+            : plan.kind === "continue"
+              ? `Resumed "${thread.title}" on ${plan.target.id} (${pct(plan.target.sessionRemaining)} left) after ${from} ran out.`
+              : `Moved "${thread.title}" from ${from} (${sessionLeft(from)} left) to ${plan.target.id} (${pct(plan.target.sessionRemaining)} left).`,
+      };
+      if (settings.observeOnly) {
+        yield* report(
+          `thread:${thread.id}`,
+          waitForResetAtMs !== undefined ? "would_wait_for_reset" : `would_${plan.kind}`,
+          fields,
+        );
+        continue;
+      }
+      const moved = yield* threads.dispatch(plan.command).pipe(
+        Effect.andThen(report(`thread:${thread.id}`, action, fields)),
+        Effect.as(true),
+        Effect.catchCause((cause) =>
+          report(`thread:${thread.id}`, "switch_failed", {
+            ...fields,
+            message: `Could not move "${thread.title}" to ${plan.target.id}.`,
+            cause: describe(cause),
+          }).pipe(Effect.as(false)),
+        ),
+      );
+      if (!moved || plan.kind !== "continue") continue;
+      continuesAtMs.set(thread.id, [
+        ...(continuesAtMs.get(thread.id) ?? []).filter(
+          (atMs) => nowMs - atMs <= CONTINUE_WITHIN_MS,
+        ),
+        nowMs,
+      ]);
+      yield* moveQueuedMessages(threads, {
+        threadId: thread.id,
+        from,
+        modelSelection: { ...thread.modelSelection, instanceId: plan.target.id },
+      }).pipe(
+        Effect.flatMap((messages) =>
+          messages === 0
+            ? Effect.void
+            : log("queue_moved", {
+                threadId: thread.id,
+                to: plan.target.id,
+                messages,
+                message: `Queued ${messages} waiting message(s) of "${thread.title}" on ${plan.target.id}.`,
+              }),
+        ),
+        Effect.catchCause((cause) =>
+          log("queue_move_failed", { threadId: thread.id, cause: describe(cause) }),
+        ),
+      );
+    }
+
+    if (!settings.observeOnly) {
+      for (const thread of finishedActivationThreads(shells, nowMs)) {
+        yield* threads
+          .dispatch({
+            type: "thread.delete",
+            commandId: CommandId.make(`claude-quota:hi-delete:${thread.id}`),
+            threadId: thread.id,
+          })
+          .pipe(
+            Effect.catchCause((cause) =>
+              report(`activation-delete:${thread.id}`, "activation_delete_failed", {
+                threadId: thread.id,
+                cause: describe(cause),
+              }),
+            ),
+          );
+      }
+    }
+
+    for (const provider of settings.activate ? providers : []) {
+      const account = readAccountQuota(provider);
+      const sentAtMs = lastActivationMs.get(account.id);
+      if (!isAccountFull(account, settings, nowMs)) {
+        if (awaitingConfirmation.has(account.id) && isActivationConfirmed(account, sentAtMs)) {
+          awaitingConfirmation.delete(account.id);
+          lastActivationMs.delete(account.id);
+          yield* log("activation_confirmed", {
+            account: account.id,
+            sessionResetsAt: isoOrNull(account.sessionResetsAtMs),
+            message: `${account.id}'s 5-hour window is running until ${isoOrNull(account.sessionResetsAtMs)}.`,
+          });
+        }
+        fullSinceMs.delete(account.id);
+      } else if (!fullSinceMs.has(account.id)) {
+        fullSinceMs.set(account.id, account.checkedAtMs);
+      }
+      const resetAtMs = lastResetAtMs.get(account.id);
+      const busy = shells.some(
+        (thread) =>
+          thread.modelSelection.instanceId === account.id &&
+          (thread.activeRunId !== null ||
+            RUNNING.has(thread.status) ||
+            (resetAtMs !== undefined &&
+              thread.latestRunRequestedAt != null &&
+              DateTime.toEpochMillis(thread.latestRunRequestedAt) >= resetAtMs)),
+      );
+      const due = isActivationDue({
+        account,
+        fullSinceMs: fullSinceMs.get(account.id),
+        lastAttemptMs: lastActivationMs.get(account.id),
+        lastResetAtMs: resetAtMs,
+        busy,
+        config: settings,
+        nowMs,
+      });
+      if (!due) continue;
+      if (settings.observeOnly) {
+        yield* report(`activation:${account.id}`, "would_activate", { account: account.id });
+        continue;
+      }
+      lastActivationMs.set(account.id, nowMs);
+      yield* activate(provider, settings, nowMs).pipe(
+        Effect.andThen(
+          Effect.suspend(() => {
+            awaitingConfirmation.add(account.id);
+            return log("activation_sent", {
+              account: account.id,
+              text: ACTIVATION_TEXT,
+              message: `Started ${account.id}'s 5-hour window with a short "Hi".`,
+            });
+          }),
+        ),
+        Effect.catchCause((cause) =>
+          log("activation_failed", {
+            account: account.id,
+            cause: describe(cause),
+            message: `Could not start ${account.id}'s 5-hour window.`,
+          }),
+        ),
+      );
+    }
+
+    // State per run and thread would otherwise grow for as long as the server runs.
+    const liveThreads = new Set<string>(shells.map((thread) => thread.id));
+    for (const [runId, run] of limitedRuns) {
+      if (nowMs - run.atMs > CONTINUE_WITHIN_MS) limitedRuns.delete(runId);
+    }
+    for (const [threadId, times] of continuesAtMs) {
+      if (!liveThreads.has(threadId) || times.every((atMs) => nowMs - atMs > CONTINUE_WITHIN_MS))
+        continuesAtMs.delete(threadId);
+    }
+    for (const key of lastReported.keys()) {
+      const separator = key.indexOf(":");
+      const scope = key.slice(0, separator);
+      if (
+        (scope === "thread" || scope === "activation-delete") &&
+        !liveThreads.has(key.slice(separator + 1))
+      )
+        lastReported.delete(key);
+    }
+  });
+
+  // Untraced because it sees every domain event, streaming deltas included.
+  const onDomainEvent = Effect.fnUntraced(function* (event: OrchestrationV2DomainEvent) {
+    if (!wakesSweepEarly(event)) return;
+    const atMs = DateTime.toEpochMillis(yield* DateTime.now) + RUN_SETTLE_MS;
+    if (earlySweepAtMs === null || atMs < earlySweepAtMs) earlySweepAtMs = atMs;
+  });
+
+  return {
+    sweep: sweep().pipe(
+      Effect.catchCause((cause) => report("sweep", "sweep_failed", { cause: describe(cause) })),
+      Effect.ensuring(flushNotices),
+    ),
+    // Without it the minute sweep still finds limited runs, only later.
+    events: Stream.runForEach(threads.streamDomainEvents, onDomainEvent).pipe(
+      Effect.catchCause((cause) => log("events_failed", { cause: describe(cause) })),
+    ),
+  };
+});
+
+export const layer = Layer.effectDiscard(
+  Effect.gen(function* () {
+    const { sweep, events } = yield* make;
+    const scheduler = yield* Scheduler.Scheduler;
+    yield* scheduler.register("claude-quota-autopilot", sweep);
+    yield* forkParked(events);
+  }),
+);
