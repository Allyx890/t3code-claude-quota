+  ]);
+  const pending = Promise.withResolvers<{ _tag: string }>();
+  const started = Promise.withResolvers<void>();
+  state.refreshProviders
+    .mockImplementationOnce(() => {
+      started.resolve();
+      return pending.promise;
+    })
+    .mockResolvedValue({ _tag: "Success" });
+  const limits = useRefreshLimits();
+  const automatic = state.autoRefresh();
+  await started.promise;
+  expect(state.refreshProviders).toHaveBeenCalledWith({ environmentId, input: {} });
+  const manual = limits.refresh();
+  pending.resolve({ _tag: "Success" });
+  await Promise.all([automatic, manual]);
+  expect(state.refreshProviders).toHaveBeenCalledTimes(2);
+  expect(state.refreshProviders).toHaveBeenLastCalledWith({
+    environmentId,
+    input: { fresh: true },
+  });
+  await state.autoRefresh();
+  expect(state.refreshProviders).toHaveBeenCalledTimes(2);
+});
