+export function isActivationConfirmed(account: AccountQuota, sentAtMs: number | undefined) {
+  return (
+    sentAtMs !== undefined &&
+    account.sessionResetsAtMs !== null &&
+    account.sessionResetsAtMs > sentAtMs
