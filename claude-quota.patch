+      commandId: CommandId.make(`claude-quota:project:${input.attempt}`),
+      // Bootstrap reuses whichever project already owns the folder.
+      projectId: ProjectId.make("claude-quota-activation"),
+      title: "Claude quota timers",
+      workspaceRoot: input.root,
+      createWorkspaceRootIfMissing: true,
+      defaultModelSelection: input.modelSelection,
+    });
+    return project;
+  },
+);
