+      readonly modelSelection: ModelSelection;
+      readonly attempt: string;
+    },
+  ) {
+    // Bootstrap first looks the folder up, which fails while it is missing, so its own
+    // createWorkspaceRootIfMissing is never reached.
+    yield* fs.makeDirectory(input.root, { recursive: true });
